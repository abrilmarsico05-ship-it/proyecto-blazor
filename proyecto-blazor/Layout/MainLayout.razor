@inherits LayoutComponentBase

<div class="d-flex" id="wrapper">
    <div class="bg-dark border-right @(MostrarMenu ? "" : "d-none")" id="sidebar-wrapper" style="width: 250px; min-height: 100vh;">
        <div class="sidebar-heading text-white p-3">App MVC</div>
        <div class="list-group list-group-flush">
            <a href="#" class="list-group-item list-group-item-action bg-dark text-white p-3">Inicio</a>
            <a href="#" class="list-group-item list-group-item-action bg-dark text-white p-3">Perfil</a>
        </div>
    </div>

    <div id="page-content-wrapper" class="w-100">
        <nav class="navbar navbar-light bg-light border-bottom px-3">
            <button class="btn btn-primary" @onclick="AlternarMenu">☰ Menú</button>
        </nav>

        <div class="container-fluid p-4">
            @Body
        </div>
    </div>
</div>

@code {
    private bool MostrarMenu = true;

    private void AlternarMenu()
    {
        MostrarMenu = !MostrarMenu;
    }
}