<div class="@($"d-flex align-items-center border-bottom border-secondary {(Expanded ? "px-3" : "justify-content-center")}")"
     style="height: 60px;">

    <button class="btn btn-link text-white p-0 border-0" @onclick="OnToggle" title="Alternar Menú">
        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-list" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H2.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H2.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H2.5z" />
        </svg>
    </button>

</div>

<div class="d-flex flex-column p-2 mt-2">

    <NavLink class="@($"nav-link text-white mb-2 d-flex align-items-center {(Expanded ? "px-3" : "justify-content-center")}")" href="" Match="NavLinkMatch.All">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-house-door-fill flex-shrink-0" viewBox="0 0 16 16">
            <path d="M6.5 14.5v-3.505c0-.245.25-.495.5-.495h2c.25 0 .5.25.5.495v3.505a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5Z" />
        </svg>
        @if (Expanded)
        {
            <span class="ms-3">Inicio</span>
        }
    </NavLink>

    <NavLink class="@($"nav-link text-white mb-2 d-flex align-items-center {(Expanded ? "px-3" : "justify-content-center")}")" href="perfil">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-person-fill flex-shrink-0" viewBox="0 0 16 16">
            <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H3Zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
        </svg>
        @if (Expanded)
        {
            <span class="ms-3">Perfil</span>
        }
    </NavLink>

    <NavLink class="@($"nav-link text-white mb-2 d-flex align-items-center {(Expanded ? "px-3" : "justify-content-center")}")" href="configuracion">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-gear-fill flex-shrink-0" viewBox="0 0 16 16">
            <path d="M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 0 1-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.464 1.464 0 0 1 .872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 0 1 2.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 0 1 2.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 0 1 .872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 0 1-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 0 1-2.105-.872l-.1-.34zM8 10.93a2.929 2.929 0 1 1 0-5.86 2.929 2.929 0 0 1 0 5.86z" />
        </svg>
        @if (Expanded)
        {
            <span class="ms-3">Configuración</span>
        }
    </NavLink>

</div>

@code {
    [Parameter] public bool Expanded { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
}